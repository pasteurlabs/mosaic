          "op": "min"
        },
        "axis": {
          "domain": false,
          "ticks": false,
          "labelPadding": 6
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "rule",
          "strokeWidth": 2,
          "opacity": 0.35
        },
        "transform": [
          {
            "filter": "datum.lo < datum.hi"
          }
        ],
        "encoding": {
          "x": {
            "field": "lo",
            "type": "quantitative"
          },
          "x2": {
            "field": "hi"
          },
          "color": {
            "value": "#8b8f96"
          }
        }
      },
      {
        "mark": {
          "type": "point",
          "filled": true,
          "size": 70,
          "opacity": 1
        },
        "encoding": {
          "x": {
            "field": "seconds",
            "type": "quantitative",
            "scale": {
              "type": "log"
            },
            "title": "Wall time (s), log scale",
            "axis": {
              "format": "~g",
              "grid": true,
              "gridOpacity": 0.5
            }
          },
          "color": {
            "field": "pass",
            "type": "nominal",
            "title": null,
            "scale": {
              "domain": ["Forward", "VJP"],
              "range": ["#8b8f96", "#c8613a"]
            },
            "legend": {
              "orient": "top",
              "direction": "horizontal"
            }
          },
          "shape": {
            "field": "device",
            "type": "nominal",
            "title": null,
            "scale": {
              "domain": ["GPU", "CPU"],
              "range": ["circle", "square"]
            },
            "legend": {
              "orient": "top",
              "direction": "horizontal"
            }
          },
          "tooltip": [
            {
              "field": "solver",
              "title": "Solver"
            },
            {
              "field": "device",
              "title": "Device"
            },
            {
              "field": "pass",
              "title": "Pass"
            },
            {
              "field": "time",
              "title": "Wall time"
            }
          ]
        }
