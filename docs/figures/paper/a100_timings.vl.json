        "S, cantilever (128×2×64)",
        "H, heat (256×128×1)"
      ],
      "header": {
        "labelAngle": 0,
        "labelAlign": "left",
        "labelAnchor": "start",
        "labelOrient": "top",
        "labelPadding": 6
      }
    }
  },
  "spacing": 14,
  "resolve": {
    "scale": {
      "y": "independent"
