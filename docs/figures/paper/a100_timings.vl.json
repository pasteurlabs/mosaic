  "transform": [
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "seconds",
          "as": "lo"
        },
        {
          "op": "max",
          "field": "seconds",
          "as": "hi"
        }
      ],
      "groupby": ["task", "solver"]
    },
    {
      "calculate": "datum.seconds < 1 ? format(datum.seconds * 1000, ',.3~r') + ' ms' : format(datum.seconds, ',.3~r') + ' s'",
      "as": "time"
    }
  ],
  "facet": {
    "row": {
