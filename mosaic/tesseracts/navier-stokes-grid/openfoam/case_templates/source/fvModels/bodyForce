    codeAddSup
    #{
        // The force at the cell centres, read once from 0/F.
        static autoPtr<volVectorField> F;
        if (!F.valid())
        {
            F.reset
            (
                new volVectorField
                (
                    IOobject
                    (
                        "F",
                        "0",
                        mesh(),
                        IOobject::MUST_READ,
                        IOobject::NO_WRITE
                    ),
                    mesh()
                )
            );
        }
        eqn += F();
    #};
}
